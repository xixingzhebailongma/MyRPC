# CMake 构建目录：每个配置一个独立目录（build/、build-asan/、build-tsan/、
# build-ubsan/、build-bench/ 等），统一用 build*/ 忽略，避免逐个枚举。
build*/
.cache/
**/.clangd
compile_commands.json
*.pb.cc
*.pb.h
apps/im/certs/
*.log

# 编辑器 / IDE 临时文件
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# 核心转储
core
core.*

# 编译产物兜底（通常已在 build*/ 内，双保险）
a.out
*.o
*.a
*.so
